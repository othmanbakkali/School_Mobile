<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ems_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">.ems_res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
               <xpath expr="//form[hasclass('oe_form_configuration')]" position="inside">
                   <app data-string="EMS" string="EMS" name="nthub_ems">
                        <block title="Education Management System">
                            <setting help="Define Evaluation Type">
                                <field name="evaluation_type"/>
                            </setting>
                            <setting help="Set the current school year">
                                <field name="school_year"/>
                            </setting>
                            <setting help="Upload the application logo">
                                <field name="school_logo" widget="image"/>
                            </setting>
                            <setting help="Enter school identification and contact details">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="school_name" class="col-lg-3 o_light_label"/>
                                        <field name="school_name" class="oe_inline"/>
                                    </div>
                                    <div class="row">
                                        <label for="school_phone" class="col-lg-3 o_light_label"/>
                                        <field name="school_phone" class="oe_inline"/>
                                    </div>
                                    <div class="row">
                                        <label for="school_email" class="col-lg-3 o_light_label"/>
                                        <field name="school_email" class="oe_inline"/>
                                    </div>
                                    <div class="row">
                                        <label for="school_address" class="col-lg-3 o_light_label"/>
                                        <field name="school_address" class="oe_inline"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="ems_settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'nthub_ems', 'bin_size': False}</field>
        </record>

    </data>
</odoo>
