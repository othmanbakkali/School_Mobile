<odoo>
    <!-- Action pour la gestion des onglets mobile -->
    <record id="action_school_mobile_tab" model="ir.actions.act_window">
        <field name="name">Onglets App Mobile</field>
        <field name="res_model">school.mobile.tab</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez les onglets et les droits d'accès de l'application mobile.
            </p>
        </field>
    </record>

    <!-- Vue Liste pour les onglets -->
    <record id="view_school_mobile_tab_tree" model="ir.ui.view">
        <field name="name">school.mobile.tab.list</field>
        <field name="model">school.mobile.tab</field>
        <field name="arch" type="xml">
            <list string="Onglets App Mobile" editable="bottom">
                <header>
                    <button name="action_generate_default_tabs" string="Générer les 19 onglets par défaut" type="object" class="oe_highlight"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_code"/>
                <field name="icon"/>
                <field name="path"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="group_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire pour les onglets -->
    <record id="view_school_mobile_tab_form" model="ir.ui.view">
        <field name="name">school.mobile.tab.form</field>
        <field name="model">school.mobile.tab</field>
        <field name="arch" type="xml">
            <form string="Paramétrage Onglet Mobile">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'onglet (ex: Devoirs)"/></h1>
                    </div>
                    <group>
                        <group string="Configuration Générale">
                            <field name="technical_code"/>
                            <field name="icon"/>
                            <field name="path"/>
                            <field name="sequence"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        <group string="Droits d'Accès &amp; Restrictions">
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="allowed_user_ids" widget="many2many_tags"/>
                            <field name="denied_user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menuitem sous Configuration -->
    <menuitem id="menu_school_mobile_tab_config"
              name="Onglets App Mobile"
              parent="menu_mobile_v2_config"
              action="action_school_mobile_tab"
              sequence="5"/>
</odoo>
