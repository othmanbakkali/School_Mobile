<odoo>
    <!-- ACTIONS -->
    <record id="action_student_mobile" model="ir.actions.act_window">
        <field name="name">Élèves</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier élève !
            </p>
        </field>
    </record>

    <record id="action_level_v2" model="ir.actions.act_window">
        <field name="name">Niveaux / Classes</field>
        <field name="res_model">school.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_parent_v2" model="ir.actions.act_window">
        <field name="name">Parents</field>
        <field name="res_model">school.parent</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_attendance_v2" model="ir.actions.act_window">
        <field name="name">Absences &amp; Retards</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_canteen_v2" model="ir.actions.act_window">
        <field name="name">Cantine (Menu)</field>
        <field name="res_model">school.canteen.menu</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_schedule_v2" model="ir.actions.act_window">
        <field name="name">Emploi du temps</field>
        <field name="res_model">school.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_homework_v2" model="ir.actions.act_window">
        <field name="name">Devoirs</field>
        <field name="res_model">school.homework</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_announcement_v2" model="ir.actions.act_window">
        <field name="name">Messages aux Parents</field>
        <field name="res_model">school.announcement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_grade_v2" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <!-- Menu Racine -->
    <menuitem id="menu_mobile_v2_root" 
              name="Scolarité Mobile" 
              web_icon="base,static/description/icon.png"
              sequence="1"/>

    <!-- Sous-menus -->
    <menuitem id="menu_mobile_v2_student" 
              name="Élèves" 
              parent="menu_mobile_v2_root" 
              action="action_student_mobile" 
              sequence="10"/>

    <menuitem id="menu_mobile_v2_grade" 
              name="Notes" 
              parent="menu_mobile_v2_root" 
              action="action_grade_v2" 
              sequence="15"/>

    <menuitem id="menu_mobile_v2_level" 
              name="Niveaux / Classes" 
              parent="menu_mobile_v2_root" 
              action="action_level_v2" 
              sequence="20"/>

    <menuitem id="menu_mobile_v2_parent" 
              name="Parents" 
              parent="menu_mobile_v2_root" 
              action="action_parent_v2" 
              sequence="30"/>

    <menuitem id="menu_mobile_v2_attendance" 
              name="Absences / Retards" 
              parent="menu_mobile_v2_root" 
              action="action_attendance_v2" 
              sequence="40"/>

    <menuitem id="menu_mobile_v2_canteen" 
              name="Cantine" 
              parent="menu_mobile_v2_root" 
              action="action_canteen_v2" 
              sequence="50"/>

    <menuitem id="menu_mobile_v2_schedule" 
              name="Emploi du Temps" 
              parent="menu_mobile_v2_root" 
              action="action_schedule_v2" 
              sequence="60"/>

    <menuitem id="menu_mobile_v2_homework" 
              name="Devoirs" 
              parent="menu_mobile_v2_root" 
              action="action_homework_v2" 
              sequence="65"/>

    <menuitem id="menu_mobile_v2_announcement" 
              name="Messages" 
              parent="menu_mobile_v2_root" 
              action="action_announcement_v2" 
              sequence="70"/>

    <!-- VUES CLASSES -->
    <record id="view_level_tree" model="ir.ui.view">
        <field name="name">school.level.tree</field>
        <field name="model">school.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- VUES PARENTS -->
    <record id="view_parent_form" model="ir.ui.view">
        <field name="name">school.parent.form</field>
        <field name="model">school.parent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du Parent"/></h1>
                    </div>
                    <group>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <notebook>
                        <page string="Enfants" name="children">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="level_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VUES NOTES -->
    <record id="view_grade_tree" model="ir.ui.view">
        <field name="name">school.grade.tree</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="student_id"/>
                <field name="subject"/>
                <field name="oral_mark"/>
                <field name="mid_term_mark"/>
                <field name="final_mark" sum="Moyenne"/>
            </list>
        </field>
    </record>

    <record id="view_grade_form" model="ir.ui.view">
        <field name="name">school.grade.form</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="oral_mark"/>
                            <field name="mid_term_mark"/>
                            <field name="final_mark"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VUES ÉTUDIANTS (Mise à jour) -->
    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Liste des Élèves">
                <field name="name"/>
                <field name="level_id"/>
                <field name="parent_id"/>
                <field name="average_grade" avg="Moyenne" decoration-bf="1"/>
            </list>
        </field>
    </record>

    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Fiche Élève">
                <header>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" options="{'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex: Jean Dupont"/></h1>
                    </div>
                    <group>
                        <group string="Détails">
                            <field name="level_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="parent_id" options="{'no_quick_create': True}"/>
                        </group>
                        <group string="Moyenne">
                            <field name="average_grade" readonly="1" decoration-bf="1" decoration-success="average_grade >= 10" decoration-danger="average_grade &lt; 10"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="grades">
                            <field name="grade_ids" mode="list">
                                <list editable="bottom">
                                    <field name="subject"/>
                                    <field name="oral_mark"/>
                                    <field name="mid_term_mark"/>
                                    <field name="final_mark" decoration-bf="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Absences" name="attendance">
                            <field name="attendance_ids" mode="list">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="type"/>
                                    <field name="duration" invisible="type != 'late'"/>
                                    <field name="is_justified" widget="boolean_toggle"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Devoirs" name="homework">
                            <field name="homework_ids" mode="list">
                                <list editable="bottom">
                                    <field name="date_due"/>
                                    <field name="title"/>
                                    <field name="subject"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VUES EMPLOI DU TEMPS -->
    <record id="view_schedule_tree" model="ir.ui.view">
        <field name="name">school.schedule.tree</field>
        <field name="model">school.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="subject"/>
                <field name="level_id"/>
            </list>
        </field>
    </record>

    <!-- VUES ABSENCES -->
    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">school.attendance.tree</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list decoration-danger="type == 'absence'" decoration-warning="type == 'late'">
                <field name="date"/>
                <field name="student_id"/>
                <field name="type"/>
                <field name="duration" invisible="type != 'late'"/>
                <field name="is_justified" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- VUES MESSAGES -->
    <record id="view_announcement_form" model="ir.ui.view">
        <field name="name">school.announcement.form</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Titre de l'annonce"/></h1>
                    </div>
                    <group>
                        <field name="level_id" placeholder="Tous les niveaux"/>
                        <field name="date"/>
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                    <separator string="Contenu"/>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VUES DEVOIRS -->
    <record id="view_homework_form" model="ir.ui.view">
        <field name="name">school.homework.form</field>
        <field name="model">school.homework</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" clickable="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Ex: Exercice de maths"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="date_due"/>
                        </group>
                        <group>
                            <field name="level_id"/>
                            <field name="student_id" invisible="level_id != False" required="not level_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                    <separator string="Description"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_homework_tree" model="ir.ui.view">
        <field name="name">school.homework.tree</field>
        <field name="model">school.homework</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_due"/>
                <field name="title"/>
                <field name="subject"/>
                <field name="student_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>
</odoo>
