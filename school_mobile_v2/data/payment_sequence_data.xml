<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_payment_receipt" model="ir.sequence">
            <field name="name">Séquence Reçus de Paiement Scolaire</field>
            <field name="code">school.payment.receipt</field>
            <field name="prefix">REC/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_wallet_transaction_receipt" model="ir.sequence">
            <field name="name">Séquence Reçus Portefeuille Scolaire</field>
            <field name="code">school.wallet.transaction.receipt</field>
            <field name="prefix">WLT/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_shop_order" model="ir.sequence">
            <field name="name">Séquence Commandes Boutique</field>
            <field name="code">school.shop.order</field>
            <field name="prefix">CMD/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_shop_order_delivery" model="ir.sequence">
            <field name="name">Séquence Bons de Livraison Boutique</field>
            <field name="code">school.shop.order.delivery</field>
            <field name="prefix">BL/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
